# Generate a unique value of at least 32 characters for every deployment.
BETTER_AUTH_SECRET=
# Public origin with no trailing slash, for example https://radar.example.com.
BETTER_AUTH_URL=http://localhost:3000

# Gmail API sender. Keep these server-side and never prefix them with NEXT_PUBLIC_.
# Enable the Gmail API and authorize this OAuth client with the
# https://www.googleapis.com/auth/gmail.send scope and offline access.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail account (or configured Gmail "Send mail as" alias) that authorized
# the refresh token.
GMAIL_SENDER_EMAIL=your-address@gmail.com
GMAIL_SENDER_NAME=Pacific Radar
GMAIL_REPLY_TO_EMAIL=your-address@gmail.com

# Displayed in the Privacy Policy and Terms of Service.
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_OPERATOR_NAME=Pacific Radar
