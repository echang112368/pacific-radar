# Generate a unique value of at least 32 characters for every deployment.
BETTER_AUTH_SECRET=
# Public origin with no trailing slash, for example https://radar.example.com.
BETTER_AUTH_URL=http://localhost:3000

# Transactional account email (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM=Pacific Radar <accounts@example.com>
REPLY_TO_EMAIL=support@example.com

# Displayed in the Privacy Policy and Terms of Service.
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_OPERATOR_NAME=Pacific Radar
